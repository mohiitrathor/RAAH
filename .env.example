# ==============================================================================
# RAAH Environment Configuration Template (.env.example)
# Copy to .env and adjust variables as required for development or production.
# ==============================================================================

# Core Application
RAAH_APP_NAME="RAAH Dispatch & Simulation API"
RAAH_APP_VERSION="1.0.0"
RAAH_ENVIRONMENT=development    # development | staging | production
RAAH_DEBUG=false
RAAH_HOST=0.0.0.0
RAAH_PORT=8000

# Logging & Structured Observability
RAAH_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
RAAH_LOG_FORMAT=json            # json | text

# Authentication & Security
RAAH_AUTH_ENFORCED=true
RAAH_DEV_AUTH_FALLBACK=true     # MUST be false in production
# In production, RAAH_JWT_SECRET_KEY MUST be at least 32 bytes and cannot be the default key
RAAH_JWT_SECRET_KEY=raah-insecure-dev-signing-key-for-local-testing-only-change-in-production
RAAH_JWT_ALGORITHM=HS256
RAAH_JWT_EXPIRATION_MINUTES=60
RAAH_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RAAH_CORS_ALLOW_CREDENTIALS=true

# State Persistence & Durability
RAAH_PERSISTENCE_ENABLED=true
RAAH_PERSISTENCE_BACKEND=sqlite
RAAH_DATABASE_PATH=data/raah_history.db
RAAH_CHECKPOINT_INTERVAL_SECONDS=30.0
RAAH_PERSISTENCE_QUEUE_CAPACITY=10000
RAAH_AUTO_RECOVERY_ENABLED=true
RAAH_RECOVERY_FALLBACK_TO_CLEAN=true

# External Adapters & Telemetry Ingestion
RAAH_CAD_PROVIDER=mock          # mock | webhook | vendor
RAAH_HOSPITAL_PROVIDER=mock     # mock | fhir | vendor
RAAH_TRAFFIC_PROVIDER=mock      # mock | here | tomtom | vendor
RAAH_GPS_PROVIDER=mock          # mock | avl | vendor
RAAH_IDEMPOTENCY_TTL_HOURS=24
RAAH_MAX_EVENT_AGE_SECONDS=3600
RAAH_INGESTION_BURST_LIMIT=1000

# Simulation Engine
RAAH_SIMULATION_TICK_INTERVAL_SECONDS=1.0
RAAH_SIMULATION_MINUTES_PER_TICK=1
RAAH_CONSECUTIVE_ERROR_THRESHOLD=3
RAAH_REQUEST_TIMEOUT_SECONDS=30.0
